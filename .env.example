# Server-side only. Comma-separated stable Sites user IDs; blank denies access.
# Never use NEXT_PUBLIC_*, email addresses, or the local preview identity in production.
MODERATOR_USER_IDS=
# Server-only random secret (at least 32 characters); blank disables community writes.
COMMUNITY_HMAC_KEY=
# Retention is opt-in; enable only after deployment/migration and owner approval.
DATA_RETENTION_ENABLED=false
